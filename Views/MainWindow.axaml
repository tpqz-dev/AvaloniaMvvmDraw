<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaMvvmDraw.Views.MainWindow"
        Title="AvaloniaMvvmDraw" Width="800" Height="600">
  <DockPanel HorizontalAlignment="Left" VerticalAlignment="Top">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Load"/>
        <MenuItem Header="_Save"/>
        <MenuItem Header="E_xit"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About" Click="AboutMenu_Click"/>
      </MenuItem>
    </Menu>
    <!-- Autres éléments de l'interface ici -->
  </DockPanel>
</Window>
